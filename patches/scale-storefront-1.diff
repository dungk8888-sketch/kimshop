+// [SCALE] Metadata nhỏ dùng chung cho storefront.
+const loadCatalogMeta = async () => {
+  const [ss, cats] = await Promise.all([
+    supabase.from('shops').select('*').order('created_at',{ascending:false}),
+    supabase.from('categories').select('*').order('sort_order',{ascending:true}),
+  ]);
+  if(ss.error) throw ss.error; if(cats.error) throw cats.error;
+  return {
+    categories:(cats.data||[]).map(dbCategoryToUi),
+    shops:(ss.data||[]).map((x:any)=>({id:x.id,name:x.name,ownerId:x.owner_id,status:x.status,logo:x.logo_url,description:x.description})),
+  };
+};
+
+// [SCALE] Query phân trang THẬT ở database — không tải hàng nghìn sản phẩm về máy
+// rồi mới slice. Filter/search/sort đều chạy ở Supabase trước khi trả dữ liệu.
+const loadStorefrontPage = async ({offset=0, categoryId='all', search='', sortBy='popular'}: any = {}) => {
+  let q:any = supabase
+    .from('products')
+    .select('*', { count: 'exact' })
+    .neq('status','deleted');
+  if(categoryId && categoryId !== 'all') q = q.eq('category_id', categoryId);
+  const term = String(search||'').trim();
+  if(term) q = q.ilike('name', `%${term.replace(/[%_]/g, '')}%`);
+  if(sortBy==='priceAsc') q=q.order('price',{ascending:true}).order('created_at',{ascending:false});
+  else if(sortBy==='priceDesc') q=q.order('price',{ascending:false}).order('created_at',{ascending:false});
+  else if(sortBy==='rating') q=q.order('rating',{ascending:false}).order('created_at',{ascending:false});
+  else if(sortBy==='newest') q=q.order('created_at',{ascending:false});
+  else q=q.order('sold',{ascending:false}).order('created_at',{ascending:false});
+  const {data,error,count}=await q.range(offset, offset + STOREFRONT_PAGE_SIZE - 1);
+  if(error) throw error;
+  return { rawProducts:(data||[]) as any[], total:Number(count||0) };
+};
